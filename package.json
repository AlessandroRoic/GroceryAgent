{
  "name": "grocery-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server/server.ts",
    "start": "node --env-file-if-exists=.env src/server/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:built": "node --env-file-if-exists=.env dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "pnpm run lint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --test src/**/*.test.ts",
    "test:watch": "node --test --watch src/**/*.test.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "12.21.0"
  },
  "packageManager": "pnpm@12.21.0"
}
