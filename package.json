{
  "name": "grocery-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "node --watch --env-file-if-exists=.env backend/src/server/server.ts",
    "dev:frontend": "pnpm --filter @grocery-agent/frontend dev",
    "start": "node --env-file-if-exists=.env backend/src/server/server.ts",
    "build": "pnpm --filter @grocery-agent/backend build && pnpm --filter @grocery-agent/frontend build",
    "start:built": "node --env-file-if-exists=.env backend/dist/server/server.js --serve-frontend",
    "typecheck": "tsc --noEmit && tsc -p browser/tsconfig.json --noEmit && pnpm --filter @grocery-agent/frontend typecheck",
    "lint": "oxlint --type-aware --deny-warnings . && pnpm --filter @grocery-agent/frontend lint && node scripts/check-vue-lines.ts",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix . && pnpm --filter @grocery-agent/frontend lint:fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --test backend/src/**/*.test.ts && pnpm --filter @grocery-agent/frontend test",
    "test:watch": "node --test --watch backend/src/**/*.test.ts",
    "test:browser": "playwright test --config browser/playwright.config.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build && pnpm run test:browser",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "concurrently": "10.0.7",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "12.21.0"
  },
  "packageManager": "pnpm@12.21.0"
}
