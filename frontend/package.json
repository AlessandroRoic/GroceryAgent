{
  "name": "@grocery-agent/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env ./node_modules/vite/bin/vite.js",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.{css,vue}\"",
    "lint:fix": "eslint . --fix --max-warnings 0 && stylelint \"src/**/*.{css,vue}\" --fix"
  },
  "dependencies": {
    "@grocery-agent/contracts": "workspace:*",
    "reka-ui": "2.11.0",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/vue": "8.0.3",
    "@typescript-eslint/parser": "8.73.0",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "10.15.0",
    "eslint-plugin-jest-dom": "5.11.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-vue": "10.12.1",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "postcss-html": "2.0.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
