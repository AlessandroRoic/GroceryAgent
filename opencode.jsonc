{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // Secrets: never read.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": ".env.example", "effect": "allow" },
    { "action": "read", "resource": "*.envrc", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "*.npmrc", "effect": "deny" },
    { "action": "read", "resource": "*.netrc", "effect": "deny" },
    { "action": "read", "resource": "*.git-credentials", "effect": "deny" },
    { "action": "read", "resource": ".git/config", "effect": "deny" },

    // Secrets: never write.
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": ".env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.envrc", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.p12", "effect": "deny" },
    { "action": "edit", "resource": "*.pfx", "effect": "deny" },
    { "action": "edit", "resource": "*.npmrc", "effect": "deny" },
    { "action": "edit", "resource": "*.netrc", "effect": "deny" },
    { "action": "edit", "resource": "*.git-credentials", "effect": "deny" },
    { "action": "edit", "resource": ".git/config", "effect": "deny" },

    // Protect the rules and CI from silent edits.
    { "action": "edit", "resource": "opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/**", "effect": "deny" },
    { "action": "edit", "resource": ".codex/**", "effect": "deny" },
    { "action": "edit", "resource": ".github/workflows/**", "effect": "deny" },

    // No files outside this project, such as ~/.ssh or ~/.aws.
    { "action": "external_directory", "resource": "*", "effect": "deny" },

    // Shell: ask by default, allow read-only inspection and project checks.
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git add -f *", "effect": "deny" },
    { "action": "shell", "resource": "git add --force *", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr view", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list", "effect": "allow" },
    { "action": "shell", "resource": "gh pr status", "effect": "allow" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "deny" },
    { "action": "shell", "resource": "gh issue *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue view", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list", "effect": "allow" },
    { "action": "shell", "resource": "gh api *", "effect": "ask" },
    { "action": "shell", "resource": "gh auth *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm test", "effect": "allow" },
    { "action": "shell", "resource": "pnpm run check", "effect": "allow" },
    { "action": "shell", "resource": "pnpm run lint", "effect": "allow" },
    { "action": "shell", "resource": "pnpm run typecheck", "effect": "allow" },
    { "action": "shell", "resource": "pnpm run build", "effect": "allow" },
    { "action": "shell", "resource": "pnpm run format", "effect": "allow" },

    // Built-in subagents use their own, broader rules.
    { "action": "subagent", "resource": "*", "effect": "deny" },
  ],
  "policies": [
    // Hard denies: saved approvals and agent rules cannot weaken these.
    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.envrc", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.pem", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.key", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.p12", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.pfx", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.npmrc", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.netrc", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.git-credentials", "effect": "deny" },
    { "action": "tool.use", "resource": "read:.git/config", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:*.envrc", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.pem", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.key", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.p12", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.pfx", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.npmrc", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.netrc", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.git-credentials", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.git/config", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:opencode.jsonc", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.opencode/**", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.codex/**", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.github/workflows/**", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*", "effect": "deny" },
    { "action": "tool.use", "resource": "subagent:*", "effect": "deny" },
  ],
}
