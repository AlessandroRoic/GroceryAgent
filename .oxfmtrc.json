{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "ignorePatterns": [
    ".tools/**",
    ".idea/**",
    "**/dist/**",
    "test-results/**",
    "playwright-report/**",
    "coverage/**",
    "pnpm-lock.yaml"
  ]
}
